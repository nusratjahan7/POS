# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` and adjust.
# NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
PROJECT_NAME="POS API"
ENVIRONMENT=development           # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# JSON array of allowed browser origins (exact match, no trailing slash).
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database --------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos
# Optional full override (takes precedence over the parts above):
# DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos

# Separate database used by the test suite.
TEST_DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos_test

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Security --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-0000000000000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# Argon2 tuning (see pwdlib docs). RAM cost grows with time_cost.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Refresh-token cookie. Set COOKIE_SECURE=true and COOKIE_SAMESITE=lax in prod.
REFRESH_COOKIE_NAME=pos_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax               # lax | strict | none
COOKIE_DOMAIN=                    # e.g. .example.com (blank = host-only)

# --- Rate limiting (in-memory; swap for Redis in multi-process deploys) -----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute

# --- Bootstrap -------------------------------------------------------------
FIRST_SUPERUSER_EMAIL=admin@pos.example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
FIRST_SUPERUSER_FULL_NAME="Platform Administrator"
